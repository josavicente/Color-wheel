{
  "name": "colorwheel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "node scripts/with-node.mjs ./node_modules/.bin/vite",
    "build": "node scripts/with-node.mjs ./node_modules/.bin/tsc -b && node scripts/with-node.mjs ./node_modules/.bin/vite build",
    "preview": "node scripts/with-node.mjs ./node_modules/.bin/vite preview",
    "check": "node scripts/with-node.mjs ./node_modules/.bin/tsc -b --pretty false",
    "sync:catalog": "node scripts/with-node.mjs scripts/sync-paint-catalog.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
